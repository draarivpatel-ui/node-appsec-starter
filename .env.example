# Copy this file to .env only if you want explicit local values.
# Development and test modes generate ephemeral random secrets when these are absent.
# Replace every placeholder with an independently generated 32-byte random value.
# One generator: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
REDIRECT_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
SESSION_SECRET=replace-with-random-32-byte-secret
CSRF_SECRET=replace-with-random-32-byte-secret
WEBHOOK_SECRET=replace-with-random-32-byte-secret
JWT_SECRET=replace-with-random-32-byte-secret
